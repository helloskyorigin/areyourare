# AREYOURARE V2 — launch configuration
APP_URL="https://areyourare.ai.studio"
# Default to sandbox until Dodo's test checkout and refund checks pass.
DODO_MODE="test_mode"
# Server-side only. Never prefix these secrets with NEXT_PUBLIC_.
DODO_PAYMENTS_API_KEY=""
# Dodo one-time Birthday Time Capsule product, manually verified as $2 USD.
DODO_PRODUCT_ID=""
# Stable HMAC signing secret, minimum 24 characters. Use: openssl rand -base64 48
PURCHASE_COOKIE_SECRET=""
# Wikimedia On This Day public API requires no paid API key.

# Optional translated historical content (required for full Hindi story/report).
# Google Cloud Translation API Basic v2 — server-side, restricted key with billing/quota.
GOOGLE_CLOUD_TRANSLATE_API_KEY=""
