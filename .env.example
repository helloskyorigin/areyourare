# ==============================================================================
# AREYOURARE — Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# App Hosting URL (injected automatically in AI Studio / Cloud Run)
APP_URL="http://localhost:3000"

# Server-Side AI API Key (Required for AI explanations; fallback active if absent)
# Never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=""

# Rate Limiting Configuration
# Max requests per window per IP
RATE_LIMIT_MAX="30"
# Rate limit window in milliseconds (e.g. 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS="60000"

# Service Timeouts (milliseconds)
TIMEOUT_AI_MS="4000"
TIMEOUT_LOCATION_MS="3000"
TIMEOUT_CALCULATION_MS="2000"

# Engine & Dataset Versions (Defaults match production registry)
# CALCULATION_VERSION="1.0.0"
# REFERENCE_DATASET_VERSION="v1.1.0"

# ==============================================================================
# Google AdSense Monetization Layer (Optional — collapses cleanly when empty)
# ==============================================================================
NEXT_PUBLIC_ADSENSE_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_NON_PERSONALIZED="true"

# Approved Ad Unit Slot IDs (Numeric AdSense Slot IDs)
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=""
NEXT_PUBLIC_ADSENSE_SLOT_DISCOVER=""
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_PRIMARY=""
NEXT_PUBLIC_ADSENSE_SLOT_RESULT_SHARE=""
NEXT_PUBLIC_ADSENSE_SLOT_HOW_IT_WORKS=""
NEXT_PUBLIC_ADSENSE_SLOT_FAQ=""
NEXT_PUBLIC_ADSENSE_SLOT_PRIVACY=""
